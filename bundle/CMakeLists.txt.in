# agent.lean source bundle, generated by scripts/bundle.py. Needs only CMake and a C/C++20 compiler.
cmake_minimum_required(VERSION 3.20)
project(agentlean_bundle C CXX)

set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_C_STANDARD 11)
option(AGENTLEAN_OPT_SIZE "Optimize for size (-Os) instead of speed (-O2)" OFF)
if(NOT CMAKE_BUILD_TYPE)
  set(CMAKE_BUILD_TYPE Release)
endif()

file(GLOB LEAN_C ${CMAKE_CURRENT_SOURCE_DIR}/lean/*.c)
file(GLOB RUNTIME_CPP ${CMAKE_CURRENT_SOURCE_DIR}/runtime/*.cpp)
file(GLOB EXTRA_SRC ${CMAKE_CURRENT_SOURCE_DIR}/extra/*.c ${CMAKE_CURRENT_SOURCE_DIR}/extra/*.cpp)

add_library(agentlean STATIC ${LEAN_C} ${RUNTIME_CPP} ${EXTRA_SRC}
  ${CMAKE_CURRENT_SOURCE_DIR}/shim/uv_shim.c ${CMAKE_CURRENT_SOURCE_DIR}/stubs.c
  ${CMAKE_CURRENT_SOURCE_DIR}/app_init.c)
target_include_directories(agentlean
  PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include ${CMAKE_CURRENT_SOURCE_DIR}/extra
  PRIVATE ${CMAKE_CURRENT_SOURCE_DIR} ${CMAKE_CURRENT_SOURCE_DIR}/shim)
target_compile_definitions(agentlean PRIVATE NDEBUG)
# Same code-generation flags as Lean's own `leanc`; -ffp-contract=off keeps floats identical across targets.
target_compile_options(agentlean PRIVATE
  -ffp-contract=off -fdata-sections -ffunction-sections -fvisibility=hidden -fPIC
  $<IF:$<BOOL:${AGENTLEAN_OPT_SIZE}>,-Os,-O2>
  $<$<COMPILE_LANGUAGE:C>:-w>
  $<$<COMPILE_LANGUAGE:CXX>:-w>)
find_package(Threads REQUIRED)
target_link_libraries(agentlean PUBLIC Threads::Threads)
if(ANDROID)
  target_link_libraries(agentlean PUBLIC log)
endif()

# Optional executables: every examples/*.c becomes a program linked against the library.
file(GLOB EXAMPLES ${CMAKE_CURRENT_SOURCE_DIR}/examples/*.c)
foreach(ex ${EXAMPLES})
  get_filename_component(name ${ex} NAME_WE)
  add_executable(${name} ${ex})
  target_link_libraries(${name} PRIVATE agentlean)
  set_target_properties(${name} PROPERTIES LINKER_LANGUAGE CXX)
  if(APPLE)
    target_link_options(${name} PRIVATE -Wl,-dead_strip)
  else()
    target_link_options(${name} PRIVATE -Wl,--gc-sections)
  endif()
endforeach()
